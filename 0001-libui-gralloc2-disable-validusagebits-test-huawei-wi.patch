From 6686dc8b00ed9272cba357331172a60257cf6ee7 Mon Sep 17 00:00:00 2001
From: Raphael Mounier <mounierr07@gmail.com>
Date: Mon, 8 Sep 2025 18:21:10 +0200
Subject: [PATCH] libui: gralloc2 disable validusagebits test (huawei widevine
 L1)

Change-Id: Ie50922a3dc6f8afb0e780180ff9adad273984b15
---
 libs/ui/Gralloc2.cpp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/libs/ui/Gralloc2.cpp b/libs/ui/Gralloc2.cpp
index 995dded1f7..f527feb0d5 100644
--- a/libs/ui/Gralloc2.cpp
+++ b/libs/ui/Gralloc2.cpp
@@ -112,10 +112,11 @@ status_t Gralloc2Mapper::validateBufferDescriptorInfo(
         validUsageBits = validUsageBits | getValid11UsageBits();
     }
 
+    // Huawei patch for Widevine L1 secure - all the bits are valid so don't return
     if (descriptorInfo->usage & ~validUsageBits) {
-        ALOGE("buffer descriptor contains invalid usage bits 0x%" PRIx64,
+        ALOGW("buffer descriptor contains invalid usage bits 0x%" PRIx64,
               descriptorInfo->usage & ~validUsageBits);
-        return BAD_VALUE;
+        //return BAD_VALUE;
     }
 
     // Gralloc2 implementations never understand non-BLOB with GPU_DATA_BUFFER
-- 
2.25.1

