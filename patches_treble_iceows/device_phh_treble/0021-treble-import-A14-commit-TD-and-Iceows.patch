+    if [[ "$prop_value" != "0" && "$prop_value" != "1" ]]; then
+        exit 1
+    fi
+    OTG_PATH=$(find /sys/ -path *tran_battery/OTG_CTL)
+    if [ -n "$OTG_PATH" ]; then
+        echo "$prop_value" >$OTG_PATH
+    fi
