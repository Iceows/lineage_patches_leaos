     fi
+    if [ -e /sys/class/power_supply/usb/otg_switch ]; then
+        echo "$prop_value" >/sys/class/power_supply/usb/otg_switch
+    else
+        echo "$prop_value" >/sys/class/oplus_chg/usb/otg_switch
+    fi
+    exit
+fi
+
