From aacf34df3b1f9c8a089dc0f9e9596defc5892d4c Mon Sep 17 00:00:00 2001
From: Raphael Mounier <mounierr07@gmail.com>
Date: Tue, 12 Aug 2025 15:32:14 +0200
Subject: [PATCH 18/21] huawei: add extra folder for TEE DRM Modem and logging

---
 board-base.mk          |  2 +-
 sepolicy/file_contexts |  5 +++++
 sepolicy/huawei.te     | 11 ++++++++++-
 3 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/board-base.mk b/board-base.mk
index 77182a0..b45ca3c 100644
--- a/board-base.mk
+++ b/board-base.mk
@@ -6,7 +6,7 @@ BOARD_BLUETOOTH_BDROID_BUILDCFG_INCLUDE_DIR := device/phh/treble/bluetooth/inclu
 TARGET_EXFAT_DRIVER := exfat
 DEVICE_FRAMEWORK_MANIFEST_FILE := device/phh/treble/framework_manifest.xml
 
-BOARD_ROOT_EXTRA_FOLDERS += bt_firmware sec_storage efs persist
+BOARD_ROOT_EXTRA_FOLDERS += sec_storage res splash2 preavs modem_log bt_firmware efs persist
 BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES := true
 BUILD_BROKEN_DUP_RULES := true
 
diff --git a/sepolicy/file_contexts b/sepolicy/file_contexts
index 3bc437c..b2dcf51 100644
--- a/sepolicy/file_contexts
+++ b/sepolicy/file_contexts
@@ -20,3 +20,8 @@
 
 /dev/smcinvoke u:object_r:smcinvoke_device:s0
 /system/bin/hw/android\.hardware\.bluetooth\.audio-service-system u:object_r:hal_audio_sysbta_exec:s0
+
+/modem_log(/.*)?      u:object_r:modem_log_file:s0
+/splash2(/.*)?        u:object_r:splash2_data_file:s0
+/preavs(/.*)?         u:object_r:vendor_file:s0
+
diff --git a/sepolicy/huawei.te b/sepolicy/huawei.te
index a52564a..b0a71b6 100644
--- a/sepolicy/huawei.te
+++ b/sepolicy/huawei.te
@@ -25,7 +25,6 @@ type sys_block_mmcblk0, file_type;
 allow init sys_block_mmcblk0:lnk_file read;
 allow init sysfs_zram:lnk_file read;
 
-
 # --------------------------------- TEE -------------------------------------------------
 type teecd_data_file, file_type;
 type teecd_data_file_system, file_type;
@@ -126,7 +125,11 @@ vendor_internal_prop(vendor_wifi_version)
 
 # --------------------- Huawei EMUI10 WIFI  ----------------------------------------------
 allow hal_wifi_default system_data_file:lnk_file { read };
+set_prop(hal_wifi_default, vendor_default_prop)
+
 
+# --------------------- Preavs : Widevine and DRM ---------------------------
+type preavs_data_file, file_type;
 
 # --------------------- Splash2 is a partition with huawei log ---------------------------
 # Add support off splash2 Huawei logging
@@ -253,6 +256,9 @@ allow installd system_server:dir { search };
 
 allow system_server sysfs_zram:lnk_file { read };
 allow system_server vendor_file:file r_file_perms;
+allow system_server sysfs:file { read };
+allow system_server tmpfs:dir { read };
+
 allow kernel sysfs_devices_system_cpu:file rw_file_perms;
 allow network_stack fs_bpf:file rw_file_perms;
 
@@ -337,6 +343,8 @@ type storage_info, domain;
 type mediacodec, domain;
 type plateform_app, domain;
 
+type fold_prop, property_type;
+
 get_prop(system_app, cameradaemon_prop)
 get_prop(rild, config_prop)
 get_prop(rild, system_prop)
@@ -367,6 +375,7 @@ get_prop(audioserver, vendor_default_prop)
 get_prop(hal_wifi_supplicant_default, default_prop)
 get_prop(surfaceflinger, vendor_default_prop)
 get_prop(mediacodec, default_prop)
+get_prop(mediacodec, fold_prop)
 get_prop(plateform_app, vendor_default_prop)
 
 # ------------- hi110x wifi supplicant custom ------------------
-- 
2.25.1

