From 7d2763d2f4d2e1310d71a504a54b520fb0941183 Mon Sep 17 00:00:00 2001
From: Raphael Mounier <mounierr07@gmail.com>
Date: Tue, 30 Dec 2025 20:16:27 +0100
Subject: [PATCH] huawei: remove old make and add also non gapps for old device

---
 generate.sh | 25 ++++++++++---------------
 1 file changed, 10 insertions(+), 15 deletions(-)

diff --git a/generate.sh b/generate.sh
index 5f0df55..26f71f6 100644
--- a/generate.sh
+++ b/generate.sh
@@ -15,7 +15,7 @@ fi
 echo 'PRODUCT_MAKEFILES := \' > AndroidProducts.mk
 
 for part in a ab;do
-	for apps in vanilla gapps foss gapps-go old;do
+	for apps in vanilla gapps gapps-old old erofs;do
 		for arch in arm64 arm a64;do
 			for su in yes no;do
 				apps_suffix=""
@@ -35,32 +35,27 @@ for part in a ab;do
 					apps_script='$(call inherit-product, vendor/gapps/'$baseArch'/'$baseArch'-vendor.mk)'
 					apps_name="with GApps"
 				fi
-				if [ "$apps" == "gapps-go" ];then
-					apps_suffix="o"
-					apps_script='$(call inherit-product, device/phh/treble/gapps-go.mk)'
-					apps_name="Go"
-				fi
-				if [ "$apps" == "foss" ];then
-					apps_suffix="f"
-					apps_script='$(call inherit-product, vendor/foss/foss.mk)'
-					apps_name="with FOSS apps"
-				fi
 				if [ "$apps" == "vanilla" ];then
 					apps_suffix="v"
 					apps_script=''
 					apps_name="vanilla"
 				fi
-				if [ "$apps" == "old" ];then
+				if [ "$apps" == "gapps-old" ];then
 					apps_suffix="y"
 					apps_script='$(call inherit-product, vendor/gapps/'$baseArch'/'$baseArch'-vendor.mk)'
 					apps_name="vanilla old with GApps"
 					optional_base='include device/phh/treble/old-vndk.mk'
 				fi
+				if [ "$apps" == "old" ];then
+					apps_suffix="o"
+					apps_script=''
+					apps_name="vanilla"
+					optional_base='include device/phh/treble/old-vndk.mk'
+				fi
 				if [ "$apps" == "erofs" ];then
 					apps_suffix="e"
-					apps_script='$(call inherit-product, vendor/gapps/'$baseArch'/'$baseArch'-vendor.mk)'
-					apps_name="erofs with GApps"
-					optional_base='include device/phh/treble/erofs-vndk.mk'
+					apps_script=''
+					apps_name="erofs"
 				fi
 				if [ "$arch" == "arm" ];then
 					vndk="vndk-binder32.mk"
-- 
2.25.1

